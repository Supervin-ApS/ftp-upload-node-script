# S3/MinIO Server Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Directory Pairs Configuration
# Define one or more directory pairs using numbered format.
# Each pair requires LOCAL and BUCKET. PREFIX and DESC are optional.

# Directory Pair 1 - Regular Images
DIR_PAIR_1_LOCAL=./websiteImages
DIR_PAIR_1_BUCKET=images
DIR_PAIR_1_PREFIX=testImages
DIR_PAIR_1_DESC=Regular Images

# Directory Pair 2 - 360-degree Images
DIR_PAIR_2_LOCAL=./360Images
DIR_PAIR_2_BUCKET=images-360
DIR_PAIR_2_PREFIX=360Images
DIR_PAIR_2_DESC=360-degree Images

# Add more directory pairs as needed:
# DIR_PAIR_3_LOCAL=./videos
# DIR_PAIR_3_BUCKET=videos
# DIR_PAIR_3_PREFIX=uploads
# DIR_PAIR_3_DESC=Video Files

# Upload Settings
MAX_CONCURRENT_UPLOADS=10
FILE_STABILITY_THRESHOLD=30000

# File Upload Retry Settings
# These settings control retry behavior for individual file uploads
# to handle network instability and timeout errors
FILE_UPLOAD_MAX_RETRIES=10
FILE_UPLOAD_INITIAL_BACKOFF_MS=2000
FILE_UPLOAD_MAX_BACKOFF_MS=60000

# Main Process Retry Settings
# These control retry at the overall process level
MAX_RETRIES=3

# Lock File
LOCK_FILE_PATH=.script.lock

# Sentry Configuration (Optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=1.0.0
# SENTRY_LOGGING=false
# SENTRY_CRON_MONITOR_ID=
