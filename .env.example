# S3/MinIO Server Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Bucket and Prefix Configuration
# Regular Images
S3_BUCKET_IMAGES=images
S3_PREFIX_IMAGES=testImages
LOCAL_DIR_IMAGES=./websiteImages

# 360-degree Images
S3_BUCKET_360=images-360
S3_PREFIX_360=360Images
LOCAL_DIR_360=./360Images

# Upload Settings
MAX_CONCURRENT_UPLOADS=10
FILE_STABILITY_THRESHOLD=30000

# File Upload Retry Settings
# These settings control retry behavior for individual file uploads
# to handle network instability and timeout errors
FILE_UPLOAD_MAX_RETRIES=10
FILE_UPLOAD_INITIAL_BACKOFF_MS=2000
FILE_UPLOAD_MAX_BACKOFF_MS=60000

# Main Process Retry Settings
# These control retry at the overall process level
MAX_RETRIES=3

# Lock File
LOCK_FILE_PATH=.script.lock

# Sentry Configuration (Optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=1.0.0
# SENTRY_LOGGING=false
# SENTRY_CRON_MONITOR_ID=
